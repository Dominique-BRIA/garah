# Référence de design clonée en lecture seule (dépôt privé d'un tiers)
.reference/

# Java / Spring Boot
target/
build/
*.class
.mvn/wrapper/maven-wrapper.jar

# Chemin du dépôt Maven local : propre à chaque poste (ici D:/Dev/.m2 parce
# que le disque C: est saturé). Ne doit pas être imposé aux autres machines.
**/.mvn/maven.config

# Node / Angular
node_modules/
dist/
.angular/
*.log

# Environnement
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.iml

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Etat local de wrangler : cache et sessions de deploiement.
# Rien d utile a partager, et peut contenir des identifiants de compte.
.wrangler/

# --- Frontend Angular --------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Les maquettes : on versionne les SOURCES (.dc.html, canvas.json), jamais le
# fichier assemble — 2,5 Mo d'editeur embarque, reconstruit a la demande.
maquettes/*.html
!maquettes/*.dc.html
