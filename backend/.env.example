# Copier ce fichier en .env et renseigner les valeurs.
# .env n'est JAMAIS versionné (voir .gitignore).

# --- Base de données -------------------------------------------------------
GARAH_DB_URL=jdbc:postgresql://localhost:5432/garah
GARAH_DB_USER=garah_app
GARAH_DB_PASSWORD=a_renseigner
GARAH_DB_POOL_MAX=8

GARAH_TEST_DB_URL=jdbc:postgresql://localhost:5432/garah_test

# En production sur Neon, l'URL exige le SSL :
# GARAH_DB_URL=jdbc:postgresql://<hote>.neon.tech/garah?sslmode=require

# --- Stockage des fichiers (Backblaze B2, compatible S3) --------------------
GARAH_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
GARAH_S3_REGION=eu-central-003
GARAH_S3_BUCKET=garah-medias
GARAH_S3_ACCESS_KEY=a_renseigner
GARAH_S3_SECRET_KEY=a_renseigner
# Préfixe public utilisé pour reconstruire les URL à partir des clés d'objet
GARAH_MEDIA_BASE_URL=https://f003.backblazeb2.com/file/garah-medias

# --- Sécurité --------------------------------------------------------------
# Le secret doit faire AU MOINS 32 octets : HMAC-SHA256 refuse une clé plus
# courte et l'application ne démarre pas.
GARAH_JWT_SECRET=a_renseigner_avec_une_valeur_longue_et_aleatoire_32_octets_min
GARAH_JWT_EXPIRATION_MINUTES=60

# --- Amorçage du premier SuperAdmin ----------------------------------------
# Créé au démarrage UNIQUEMENT s'il n'existe aucun SuperAdmin.
# À retirer de l'environnement une fois le compte créé et le mot de passe
# changé. Ne jamais mettre ces valeurs dans une migration : un mot de passe
# versionné dans git est un mot de passe public.
GARAH_SUPERADMIN_EMAIL=
GARAH_SUPERADMIN_MOT_DE_PASSE=
GARAH_SUPERADMIN_NOM=Super Administrateur

# --- Origines autorisées (CORS) : les trois frontends ----------------------
GARAH_CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# --- Version annoncee par /api/configuration -------------------------------
GARAH_VERSION=dev

# --- Paiement : Campay (agregateur MTN MoMo + Orange Money Cameroun) --------
# Sandbox : https://demo.campay.net/api/
# Production : https://www.campay.net/api/
#
# On passe par un agregateur plutot que par chaque operateur : Orange Money
# Cameroun exige un compte marchand valide, dont l'obtention prend des
# semaines. Campay expose les deux operateurs derriere une seule API.
GARAH_CAMPAY_BASE_URL=https://demo.campay.net/api
GARAH_CAMPAY_APP_USERNAME=a_renseigner
GARAH_CAMPAY_APP_PASSWORD=a_renseigner

# Cle utilisee pour verifier la signature des webhooks entrants.
# SANS elle, n'importe qui peut appeler notre webhook et declarer une
# commande payee. C'est la variable la plus sensible du fichier.
GARAH_CAMPAY_WEBHOOK_KEY=a_renseigner
