# =============================================================================
# Configuration locale de GARAH
# =============================================================================
# Copier ce fichier en .env et renseigner les valeurs.
# .env n'est JAMAIS versionné (voir .gitignore).
#
# ⚠️ UNE VARIABLE VIDE N'EST PAS UNE VARIABLE ABSENTE.
#
#    GARAH_S3_BUCKET=          ← chaîne vide, la valeur par défaut ne s'applique PAS
#    (ligne absente)           ← là, et seulement là, le défaut s'applique
#
#    Ce piège a déjà cassé toutes les images du site une fois : une ligne
#    présente mais vide donnait une URL de média relative, et pas une seule
#    erreur n'apparaissait nulle part. Le code teste donc désormais le CONTENU
#    de chaque variable, pas sa présence — mais mieux vaut ne pas y revenir.
#
# Les sections sont classées par CONSÉQUENCE : ce qui empêche l'application de
# démarrer d'abord, ce qui la dégrade ensuite.
# =============================================================================


# =============================================================================
# 1. INDISPENSABLE — sans ça, l'application ne démarre pas
# =============================================================================

# --- Base de données -------------------------------------------------------
GARAH_DB_URL=jdbc:postgresql://localhost:5432/garah
GARAH_DB_USER=garah_app
GARAH_DB_PASSWORD=a_renseigner

# Neon limite le nombre de connexions : jamais le défaut de 10 par instance.
GARAH_DB_POOL_MAX=8

# --- Passer sur Neon -------------------------------------------------------
# Neon donne UNE chaîne, l'application en attend TROIS. La conversion :
#
#   postgresql://alice:npg_secret@ep-xyz-12345678.eu-central-1.aws.neon.tech/garah?sslmode=require
#                └─user─┘└─mdp──┘ └────────────── hôte ──────────────────┘ └db┘
#
#   GARAH_DB_URL=jdbc:postgresql://ep-xyz-12345678.eu-central-1.aws.neon.tech/garah?sslmode=require
#   GARAH_DB_USER=alice
#   GARAH_DB_PASSWORD=npg_secret
#
# Trois détails qui coûtent une heure si on les rate :
#   - le préfixe devient  jdbc:postgresql://  (pas postgresql://) ;
#   - l'utilisateur et le mot de passe SORTENT de l'URL ;
#   - `sslmode=require` reste, mais on RETIRE `channel_binding=require` :
#     c'est un paramètre libpq que le pilote JDBC ne comprend pas.

# --- Base de test ----------------------------------------------------------
# ⚠️ ELLE RESTE EN LOCAL. TOUJOURS.
#
#    Les tests font des DELETE, créent des comptes et rejouent les migrations
#    depuis zéro. Pointer cette URL vers Neon DÉTRUIRAIT la base de production
#    — et il n'y a pas d'annulation.
GARAH_TEST_DB_URL=jdbc:postgresql://localhost:5432/garah_test

# Identifiants de la base de test, DISTINCTS de ceux de production.
#
# Laisser vide = on retombe sur GARAH_DB_USER / GARAH_DB_PASSWORD, ce qui
# convient tant que tout est local. Dès que GARAH_DB_* pointe vers Neon, il
# FAUT les renseigner : sinon les tests essaient de joindre localhost avec le
# mot de passe Neon, et échouent tous.
GARAH_TEST_DB_USER=garah_app
GARAH_TEST_DB_PASSWORD=a_renseigner

# --- Sécurité --------------------------------------------------------------
# ⚠️ AU MOINS 32 octets : HMAC-SHA256 refuse une clé plus courte et
#    l'application refuse de démarrer.
#
# Pour en générer un (PowerShell) :
#    -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
#
# Le changer invalide TOUS les jetons en circulation : tout le monde est
# déconnecté. C'est le comportement voulu.
GARAH_JWT_SECRET=a_renseigner_avec_une_valeur_longue_et_aleatoire_32_octets_min

# --- Durée de vie des jetons (D-19) ----------------------------------------
# ⚠️ 15 minutes, PAS 60. Un JWT ne peut pas être révoqué : sa durée de vie EST
#    le délai maximal pendant lequel un droit retiré, ou un compte bloqué,
#    reste effectif.
#
# Ce serait insupportable sans le jeton de rafraîchissement ci-dessous : les
# deux vont ensemble. Remonter cette valeur sans y penser rallonge d'autant le
# délai pendant lequel un compte bloqué reste utilisable.
GARAH_JWT_EXPIRATION_MINUTES=15

# Le jeton de rafraîchissement, lui, est STOCKÉ en base — donc révocable.
# C'est lui qui rend « déconnecter » et « bloquer un compte » réellement
# efficaces. 14 jours : au-delà, il faut ressaisir son mot de passe.
GARAH_REFRESH_EXPIRATION_JOURS=14

# --- Le cookie qui porte le jeton de rafraîchissement (D-19) ---------------
# Secure : obligatoire dès que SameSite vaut None, et de toute façon
# souhaitable. À passer à false UNIQUEMENT pour du développement en http://.
GARAH_COOKIE_SECURE=true

# ⚠️ SameSite=None est OBLIGATOIRE avec l'hébergement actuel.
#
#    frontends   garah-client.vercel.app
#    API         garah-api.onrender.com     ← autre SITE pour le navigateur
#
#    Avec Strict ou même Lax, le cookie ne serait JAMAIS envoyé : le
#    rafraîchissement échouerait toujours, et le symptôme serait une
#    déconnexion toutes les 15 minutes SANS aucune erreur serveur.
#
# 🎯 Le jour d'un vrai domaine (api.garah.cm + app.garah.cm partagent
#    garah.cm), passer à Lax : la protection CSRF devient structurelle au lieu
#    d'être portée par un jeton. C'est une raison de prendre un domaine tôt.
GARAH_COOKIE_SAMESITE=None

# Domaine du cookie. Vide = le domaine de l'API, ce qui convient tant que
# l'API et les frontends sont sur des hébergeurs différents.
# Avec un domaine propre : .garah.cm
GARAH_COOKIE_DOMAIN=


# =============================================================================
# 2. LE PREMIER DÉMARRAGE — créer le compte d'administration
# =============================================================================
# Le SuperAdmin est créé au démarrage UNIQUEMENT s'il n'en existe aucun.
#
# ⚠️ À RETIRER de l'environnement une fois le compte créé et le mot de passe
#    changé. Laisser un mot de passe d'amorçage en place, c'est laisser une
#    clé sous le paillasson.
#
# Jamais dans une migration : un mot de passe versionné dans git est un mot de
# passe public, et la migration serait rejouée à l'identique en production.
GARAH_SUPERADMIN_EMAIL=
GARAH_SUPERADMIN_MOT_DE_PASSE=
GARAH_SUPERADMIN_NOM=Super Administrateur


# =============================================================================
# 3. LE PAIEMENT — sans ça, AUCUNE commande ne peut être payée
# =============================================================================
# Campay agrège MTN MoMo et Orange Money derrière une seule API. On passe par
# un agrégateur plutôt que par chaque opérateur : Orange Money Cameroun exige
# un compte marchand dont l'obtention prend des semaines.
#
# Sans ces trois variables, POST /api/paiements répond 503 avec un message
# clair. L'application démarre, le catalogue fonctionne, mais le tunnel de
# vente s'arrête au paiement.
#
# Sandbox    : https://demo.campay.net/api     (aucun encaissement réel)
# Production : https://www.campay.net/api      (débite de vrais clients)
GARAH_CAMPAY_BASE_URL=https://demo.campay.net/api
GARAH_CAMPAY_APP_USERNAME=a_renseigner
GARAH_CAMPAY_APP_PASSWORD=a_renseigner

# --- Vérification des notifications entrantes ------------------------------
# Clé de signature des webhooks, fournie par Campay.
#
# 🎯 CE N'EST PAS ELLE QUI PROTÈGE LE WEBHOOK.
#
#    Le webhook ne croit rien de ce qu'on lui envoie : il n'en retient qu'une
#    référence de transaction, puis redemande l'état réel à Campay sur une
#    connexion que NOUS ouvrons, avec NOS identifiants. Poster une
#    notification forgée ne permet donc ni de déclarer une commande payée, ni
#    d'en changer le montant.
#
#    La signature est une défense SUPPLÉMENTAIRE. On peut démarrer sans.
GARAH_CAMPAY_WEBHOOK_KEY=

# Refuser les notifications dont la signature ne se vérifie pas.
#
# ⚠️ false par défaut, et c'est délibéré. Le format exact de la signature
#    Campay n'est pas documenté publiquement. L'activer sans l'avoir vérifié
#    transformerait une inconnue en panne totale : toutes les notifications
#    seraient rejetées et plus aucune commande ne serait payée — sans que rien
#    ne le signale, puisqu'un webhook refusé ne produit aucune erreur visible
#    côté client.
#
#    À passer à true une fois le format confirmé avec Campay. Les journaux
#    disent, à chaque notification, si la signature se vérifie :
#        "Notification Campay reference=… signature=ok"       → activable
#        "… signature=absente/invalide"                       → NE PAS activer
GARAH_CAMPAY_WEBHOOK_STRICT=false


# =============================================================================
# 4. LES FICHIERS — sans ça, aucun produit ne peut recevoir de photo
# =============================================================================
# Backblaze B2, compatible S3. Render n'a PAS de disque persistant (D-14) :
# aucun fichier n'est jamais écrit localement, même temporairement.
#
# Sans ces variables, le téléversement répond 503. Et comme l'invariant I-12
# exige au moins une photo pour publier un produit, PLUS AUCUN PRODUIT NE PEUT
# ÊTRE PUBLIÉ. C'est la dépendance la plus facile à sous-estimer.
#
# -----------------------------------------------------------------------------
# QUATRE FOURNISSEURS POSSIBLES — aucun ne demande de changer une ligne de code
# -----------------------------------------------------------------------------
# Tout passe par le SDK S3 avec un endpoint configurable. Changer de
# fournisseur, c'est changer les cinq variables ci-dessous et redémarrer.
# C'est la réversibilité exigée par D-14, et c'est ce qui rend ce choix
# réversible plutôt que définitif.
#
#   |                | Carte ? | Gratuit | Egress      | URL publique       |
#   |----------------|---------|---------|-------------|--------------------|
#   | Cloudflare R2  | OUI     | 10 Go   | 0 €         | domaine perso      |
#   | Backblaze B2   | OUI *   | 10 Go   | payant      | directe            |
#   | Supabase       | non     | 1 Go    | 5 Go        | directe            |
#   | MinIO local    | non     | —       | —           | localhost:9000     |
#
#   * B2 : « small fee that is credited to your account balance » — les frais
#     sont recrédités, mais une carte reste exigée pour un bucket PUBLIC.
#
# 🎯 L'EGRESS est le vrai critère pour GARAH, pas le stockage. Un catalogue
#    sert les mêmes images des milliers de fois : c'est de la bande passante
#    SORTANTE. R2 la facture 0 € ; B2 la facture au-delà de 3x le stockage.
#    Un catalogue qui marche coûtera en trafic bien avant de coûter en disque.
#
# --- (a) MinIO en local : pour développer, sans compte ni carte -------------
#   .\minio.exe server D:\Dev\minio-data --console-address ":9001"
#   Console http://localhost:9001 (minioadmin/minioadmin), créer le bucket,
#   puis Anonymous -> readonly sur le préfixe /
#
#   GARAH_S3_ENDPOINT=http://localhost:9000
#   GARAH_S3_REGION=us-east-1          (ignorée par MinIO, mais exigée par le SDK)
#   GARAH_S3_BUCKET=garah-medias
#   GARAH_S3_ACCESS_KEY=minioadmin
#   GARAH_S3_SECRET_KEY=minioadmin
#   GARAH_MEDIA_BASE_URL=http://localhost:9000/garah-medias
#
# --- (b) Supabase : première mise en ligne SANS carte -----------------------
#   Dashboard -> Storage -> S3 Connection donne l'endpoint, la région et les
#   clés. Créer un bucket marqué « Public ».
#
#   GARAH_S3_ENDPOINT=https://<projet>.supabase.co/storage/v1/s3
#   GARAH_S3_REGION=<region du projet>
#   GARAH_MEDIA_BASE_URL=https://<projet>.supabase.co/storage/v1/object/public/garah-medias
#
# --- (c) Cloudflare R2 : le meilleur choix, dès qu'une carte est possible ---
#   ⚠️ Le sous-domaine r2.dev est EXPRESSEMENT reserve au developpement :
#      « rate-limited and should only be used for development purposes ».
#      En production, R2 exige un DOMAINE PERSONNALISE hebergé chez Cloudflare
#      — le même domaine qui permettrait SameSite=Lax (D-19). Deux raisons
#      d'en prendre un.
#
#   GARAH_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   GARAH_S3_REGION=auto
#   GARAH_MEDIA_BASE_URL=https://medias.garah.cm      (domaine perso)
#
# --- (d) Backblaze B2 : valeurs ci-dessous ----------------------------------
#
# ⚠️ La clé MAÎTRESSE (créée automatiquement) N'EST PAS acceptée par l'API S3.
#    Backblaze est formel : « The master app key that is automatically created
#    by the system is not supported in the S3-Compatible API. »
#    Il faut créer une clé dans Account -> Application Keys -> Add a New
#    Application Key, limitée au bucket, en Read and Write. Elle n'est affichée
#    QU'UNE FOIS.
#
# La région se lit dans l'endpoint : s3.us-west-004... -> us-west-004.
# Et l'hôte de lecture porte le MÊME numéro : f004.backblazeb2.com. Un écart
# entre les deux donne des images introuvables.
GARAH_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
GARAH_S3_REGION=us-west-004
GARAH_S3_BUCKET=garah-medias
GARAH_S3_ACCESS_KEY=a_renseigner
GARAH_S3_SECRET_KEY=a_renseigner

# --- Bucket PRIVÉ : les URL doivent être signées (D-21) --------------------
# ⚠️ À mettre à true UNIQUEMENT si le bucket est privé.
#
#    Un bucket privé accepte parfaitement les téléversements — l'API S3 est
#    authentifiée. Le back-office fonctionne donc de bout en bout. Ce n'est
#    qu'au PREMIER VISITEUR que toutes les images répondent 401, et aucun
#    journal serveur ne le signale.
#
# 🎯 Conséquence à connaître : le frontend NE PEUT PLUS construire une URL à
#    partir d'une clé, puisqu'il faudrait signer. L'API renvoie donc des URL
#    complètes (champ `url` sur les médias), et /api/configuration annonce
#    `urlsMediasSignees`.
#
# Le jour où le bucket devient public (carte enregistrée, Supabase, ou MinIO
# sur le VPS) : repasser à false. RIEN D'AUTRE À CHANGER, ni côté API ni côté
# frontend.
GARAH_S3_URLS_SIGNEES=false

# Durée de validité d'une URL signée. 7 jours est le MAXIMUM autorisé par
# AWS SigV4 — demander plus produit une signature que le serveur refuse.
#
# Les URL sont mises en cache et réutilisées tant qu'il leur reste plus de
# 24 h : sans cela, chaque photo changerait d'adresse à chaque affichage, et
# le catalogue entier serait retéléchargé à chaque visite (cache navigateur
# et référencement perdus).
GARAH_S3_SIGNATURE_JOURS=7

# Préfixe public utilisé pour reconstruire les URL à partir des clés d'objet.
#
# ⚠️ Distinct de S3_ENDPOINT. L'endpoint sert à ÉCRIRE (API S3, authentifiée),
#    cette URL sert à LIRE depuis un navigateur (fichier public). Les
#    confondre donne des images qui répondent 401.
#
# La base ne stocke QUE la clé (produits/42/a3f9.jpg), jamais l'URL complète :
# changer d'hébergeur de fichiers ne doit pas obliger à réécrire la table
# media (D-14).
GARAH_MEDIA_BASE_URL=https://f003.backblazeb2.com/file/garah-medias


# =============================================================================
# 5. LE RESTE — l'application marche sans, mais mal
# =============================================================================

# --- Origines autorisées (CORS) : les trois frontends ----------------------
# ⚠️ Si cette liste est fausse, l'API répond correctement et le NAVIGATEUR
#    refuse de livrer la réponse. Le symptôme est une page vide sans la
#    moindre erreur serveur — le plus déroutant qui soit.
GARAH_CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# --- Version annoncée par GET /api/configuration ---------------------------
GARAH_VERSION=dev


# =============================================================================
# 6. L'ENVOI D'E-MAILS — sans ça, personne ne peut confirmer son adresse
# =============================================================================
# Et sans adresse confirmée, PERSONNE NE PEUT COMMANDER (D-23). C'est la
# dépendance la plus facile à sous-estimer après le stockage.
#
# Sans SMTP, l'application démarre quand même et écrit les liens de
# confirmation DANS LES JOURNAUX. Pratique en développement — jamais en
# production : un lien dans un journal est lisible par qui accède aux journaux.
#
# ⚠️ SMTP, pas l'API d'un fournisseur. Un SDK vendeur imposerait son format
#    dans notre code ; SMTP est un protocole. Changer de fournisseur = changer
#    un hôte et des identifiants (D-14, D-23).
#
# --- Brevo (ex-Sendinblue) : 300 e-mails/jour, SANS carte bancaire ----------
#   GARAH_MAIL_HOST=smtp-relay.brevo.com
#   GARAH_MAIL_PORT=587
#   GARAH_MAIL_UTILISATEUR=<votre identifiant SMTP Brevo>
#   GARAH_MAIL_MOT_DE_PASSE=<votre clé SMTP Brevo>
#
# --- Gmail : 500/jour, SANS carte, mais exige un « mot de passe application »
#   (Compte Google -> Sécurité -> Validation en 2 étapes -> Mots de passe des
#    applications. Le mot de passe habituel ne fonctionne PAS.)
#   GARAH_MAIL_HOST=smtp.gmail.com
#   GARAH_MAIL_PORT=587
#   GARAH_MAIL_UTILISATEUR=vous@gmail.com
#   GARAH_MAIL_MOT_DE_PASSE=<mot de passe application, 16 caractères>
#
GARAH_MAIL_HOST=
GARAH_MAIL_PORT=587
GARAH_MAIL_UTILISATEUR=
GARAH_MAIL_MOT_DE_PASSE=

# L'adresse affichée comme expéditeur. Chez Brevo comme chez Gmail, elle doit
# être validée côté fournisseur, sinon les envois sont refusés.
GARAH_MAIL_EXPEDITEUR=
GARAH_MAIL_NOM_EXPEDITEUR=GARAH

# Durée de validité du lien de confirmation.
GARAH_VERIFICATION_VALIDITE_HEURES=48

# Où pointe le lien reçu par e-mail.
#
# Vide = la route GET de l'API elle-même, qui renvoie une page de confirmation
# minimale. Le flux est ainsi complet SANS frontend — ce qui compte tant
# qu'Angular n'existe pas.
#
# Le jour venu : https://app.garah.cm/confirmation
GARAH_URL_VERIFICATION=

# Adresse PUBLIQUE de l'API.
#
# ⚠️ Sert à fabriquer un lien de confirmation ABSOLU. Un lien relatif
#    (/api/auth/verification?jeton=…) est valide dans une page web et
#    TOTALEMENT INUTILISABLE dans un e-mail : le client de messagerie n'a
#    aucune origine sur laquelle le résoudre.
#
#    Le message partirait, et le lien ne mènerait nulle part — sans la moindre
#    erreur, ni côté serveur ni côté client.
#
# En production, c'est l'URL du Worker Cloudflare (D-22), pas celle de Render :
# c'est elle que les visiteurs peuvent atteindre.
GARAH_URL_API=https://garah-api.d-bria00.workers.dev


# =============================================================================
# NOTIFICATIONS POUSSEES (Firebase Cloud Messaging)
# =============================================================================
# La cle du compte de service, en JSON, sur UNE SEULE LIGNE.
#
# ⚠️ C EST UN VRAI SECRET, contrairement a google-services.json — qui est
#    embarque dans chaque APK et se lit au desassemblage en trente secondes.
#    Celle-ci permet d ENVOYER au nom du projet.
#
# Console Firebase > Parametres du projet > Comptes de service >
#   Generer une nouvelle cle privee
#
# Sur Azure, c est une App Setting — jamais un fichier du depot.
#
# Absente, les notifications ne partent pas et le serveur demarre QUAND MEME :
# une notification qui ne part pas est regrettable, un serveur qui refuse de
# demarrer pour cela est absurde.
GARAH_FIREBASE_CREDENTIALS=
