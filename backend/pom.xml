<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>com.garah</groupId>
    <artifactId>garah-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>garah-backend</name>
    <description>API du systeme d'information GARAH</description>

    <properties>
        <java.version>24</java.version>
        <!-- Une seule version du SDK S3 pour s3 ET url-connection-client :
             deux versions differentes dans le meme projet produisent des
             erreurs de chargement de classe illisibles. -->
        <awssdk.version>2.31.78</awssdk.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Envoi d'e-mails, par SMTP.

             ⚠️ SMTP et NON l'API d'un fournisseur, et c'est un choix (D-23).
             Une API vendeur (Resend, SendGrid, Mailgun) imposerait son SDK,
             son format et sa gestion d'erreurs dans notre code. SMTP est un
             protocole : changer de fournisseur devient un changement d'hote
             et d'identifiants, pas une reecriture.

             C'est exactement la reversibilite exigee par D-14, appliquee a
             l'e-mail. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Authentification et autorisation. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Fournit JwtEncoder / JwtDecoder (Nimbus). On utilise la brique
             standard de Spring Security plutot qu'une bibliotheque JWT tierce :
             moins de code a maintenir, et les pieges cryptographiques sont
             deja traites. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Flyway : les migrations SQL. flyway-database-postgresql est
             obligatoire depuis Flyway 10 : le support de chaque SGBD vit
             desormais dans un artefact separe. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Stockage des fichiers. Le SDK S3 d'AWS, utilise contre Backblaze B2
             (compatible S3) : le jour de la bascule vers MinIO sur le VPS,
             seules l'URL et les cles changent, pas une ligne de code (D-14).

             ⚠️ netty-nio-client est EXCLU au profit de url-connection-client.
             Le client Netty par defaut pese ~8 Mo de dependances et demarre un
             pool de threads asynchrone dont on n'a aucun usage : on televerse
             quelques photos, pas des flux continus. Sur Render, l'image plus
             legere demarre plus vite — et chaque reveil de l'instance gratuite
             paie ce demarrage (D-14). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${awssdk.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
            <version>${awssdk.version}</version>
        </dependency>

        <!-- Lit backend/.env au demarrage et en fait des proprietes Spring.
             SANS cette dependance, .env n'est qu'un fichier de documentation :
             l'application ne lit que les variables d'environnement REELLES du
             shell, et un .env soigneusement rempli n'a aucun effet.

             En production, Render fournit de vraies variables d'environnement
             et .env n'existe pas dans l'image (il est dans .dockerignore) :
             cette dependance ne sert donc qu'au poste de developpement. -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Permet de tester la chaine de filtres de securite PAR HTTP :
             fabriquer un jeton porteur des permissions qu'on choisit, puis
             verifier qu'une route repond 200, 401 ou 403. Sans cela, la
             configuration de securite n'etait verifiee par AUCUN test — et
             c'est exactement ainsi que deux routes publiques sont restees
             fermees jusqu'au chapitre 21. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit : teste l'ARCHITECTURE comme on teste un calcul.
             Une regle d'architecture qu'on ne verifie pas est une regle
             qu'on viole le jour ou on est presse. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Permet de lancer les migrations SANS demarrer l'application :
                     mvn flyway:migrate
                     mvn flyway:info
                     mvn flyway:validate
                 La version vient du BOM Spring Boot : une seule version de
                 Flyway dans tout le projet, jamais deux. -->
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>${flyway.version}</version>
                <configuration>
                    <url>${env.GARAH_DB_URL}</url>
                    <user>${env.GARAH_DB_USER}</user>
                    <password>${env.GARAH_DB_PASSWORD}</password>
                    <locations>
                        <location>filesystem:src/main/resources/db/migration</location>
                    </locations>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>${flyway.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
